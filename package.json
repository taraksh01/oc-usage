{
  "name": "@taraksh011/oc-usage",
  "version": "1.0.0",
  "description": "OpenCode plugin — live token usage, cost, and TPS display",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["opencode", "opencode-plugin", "tokens", "tps", "cost"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Tarak Shaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taraksh01/oc-usage.git"
  },
  "homepage": "https://github.com/taraksh01/oc-usage#readme",
  "bugs": {
    "url": "https://github.com/taraksh01/oc-usage/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.6",
    "@opentui/solid": "^0.4.3",
    "@types/node": "^22",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9"
  }
}
